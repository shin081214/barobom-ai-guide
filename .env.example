# 실제 사진 AI 분석에 필요한 현재 필수 설정
GEMINI_API_KEY=your_api_key_here

# future use only: Gemini 모델 선택 (기본값: gemini-3.5-flash)
# GEMINI_MODEL=gemini-3.5-flash

# future use only: M2+ AI 백엔드 주소 (현재 검증 대상 아님)
# FASTAPI_URL=http://localhost:8000

# future use only: M2+ 데이터 계층 (현재 검증 대상 아님)
# SUPABASE_URL=
# SUPABASE_ANON_KEY=

# future use only: M1 관측성 (현재 검증 대상 아님)
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=

# 선택 설정 (기본값 사용 가능)
# PORT=4173
